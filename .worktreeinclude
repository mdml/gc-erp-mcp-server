# Files to copy from the main checkout into a `claude --worktree` worktree.
# Gitignore syntax; only matched-AND-gitignored files are copied.
# Docs: https://code.claude.com/docs/en/common-workflows#copy-gitignored-files-to-worktrees

# Per-developer dotenvx artifacts (ADR 0015). Encrypted body + matching private
# key. Both gitignored. Copying both into a fresh worktree is what makes
# `bunx dotenvx run -f .env.local -- …` work without re-keying.
.env.local
.env.keys

# Note: .claude/settings.json is now tracked in git (no longer generated by
# packages/agent-config — see ADR 0016 Slice A.4) and does not need copying
# via this file.
