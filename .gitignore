# Dependencies
node_modules/
.turbo/

# Bootstrap mutex — see `just bootstrap` (serializes concurrent installs
# when Zed's create_worktree task and Claude's SessionStart hook fire on
# the same fresh worktree).
.bootstrap.lock/

# Claude Code config — settings.json is hand-maintained and tracked (per
# ADR 0016 Slice A.4); everything else under .claude/ (projects/, todos/,
# session state) stays out of git.
.claude/*
!.claude/settings.json

# Zed worktrees — Zed's create_worktree task drops linked worktrees here
# (per docs/guides/zed.md). Always per-developer; never committed.
.worktrees/

# Cloudflare / wrangler
.wrangler/

# Secrets — dotenvx (per ADR 0015)
.env
.env.*
.env.keys
!.env.example

# Build artifacts
dist/
coverage/

# Tool artifacts (Playwright MCP browser sessions)
.playwright-mcp/

# OS
.DS_Store

# Logs
*.log

# Scratch / working docs (session prompts, handoffs — keep out of history)
PROMPTS.md
.scratch/
